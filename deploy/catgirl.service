[Unit]
Description=AI Catgirl API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/catgirl
EnvironmentFile=/opt/catgirl/.env
ExecStart=/opt/catgirl/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
User=www-data
Group=www-data

# 记忆库目录，确保 www-data 有写权限
ReadWritePaths=/opt/catgirl/data

[Install]
WantedBy=multi-user.target
