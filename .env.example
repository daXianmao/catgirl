# 复制成 .env 后按需填写。docker-compose 和 systemd 都会读这些。

# 服务商：lmstudio / ollama / openai / deepseek / moonshot / dashscope / zhipu / siliconflow / openrouter
CATGIRL_PROVIDER=dashscope

# 对话密钥（也可以用各家的标准变量名，例如 DASHSCOPE_API_KEY）
CATGIRL_API_KEY=

# 覆盖模型名（留空则用 provider 预设）
CATGIRL_MODEL=
CATGIRL_NAME=铃洛

# 向量模型可以单独指向另一家
# 例：对话用 deepseek，向量用硅基流动的 bge-m3
CATGIRL_EMBED_BASE_URL=
CATGIRL_EMBED_API_KEY=
CATGIRL_EMBED_MODEL=

# 对外接口密钥。设了之后所有 /api/* 都要带 Authorization: Bearer <这个值>
CATGIRL_SERVER_KEY=

# 数据目录（记忆库落在 <dataDir>/users/<用户标识>/memory.db）
CATGIRL_DATA=./data

# 服务监听
CATGIRL_HOST=0.0.0.0
CATGIRL_PORT=8000

# 记忆参数
CATGIRL_TOP_K=8
CATGIRL_RECENT_TURNS=12
CATGIRL_SUMMARY_EVERY=20
CATGIRL_MAX_MEMORIES=400

# ---------------- 语音 ----------------
# 后端：gptsovits（本地 GPT-SoVITS 克隆，本机默认）/ edge（免费预设音色）/
#       siliconflow（云端克隆）/ openai / none
CATGIRL_TTS_PROVIDER=gptsovits

# 预设音色。edge 例：zh-CN-XiaoyiNeural；siliconflow 例：FunAudioLLM/CosyVoice2-0.5B:claire
CATGIRL_TTS_VOICE=

# 语音密钥（硅基流动 / OpenAI）。也可以用 SILICONFLOW_API_KEY、OPENAI_API_KEY
CATGIRL_TTS_KEY=

# 覆盖服务地址，例如本地 GPT-SoVITS：http://127.0.0.1:9880
CATGIRL_TTS_BASE_URL=

# edge 专用：语速、音调
CATGIRL_TTS_RATE=+0%
CATGIRL_TTS_PITCH=+0Hz

# 对话时自动合成语音（true 时 /api/chat 默认带 audioUrl）
CATGIRL_TTS_AUTO=false

# 机器要走代理才出得去时填这里（edge 音色需要访问微软）
# CATGIRL_TTS_PROXY=http://127.0.0.1:2859

# ---------------- GPT-SoVITS 常驻服务（本机默认后端）----------------
# 猫娘会自己拉起来；也可以先手动跑它的 api_v2.py
CATGIRL_SOVITS_URL=http://127.0.0.1:9880
# 服务没起时自动拉起（需要本机已装好 GPT-SoVITS）
CATGIRL_SOVITS_AUTOSTART=true
# 这三项没有默认值，必须按自己机器上的安装位置填，否则自动拉起会失败
# CATGIRL_SOVITS_PYTHON=D:\GPT-SoVITS\env\python.exe
# CATGIRL_SOVITS_SCRIPT=D:\GPT-SoVITS\api_v2.py
# CATGIRL_SOVITS_REF=D:\GPT-SoVITS\reference.wav
# 参考音频对应的文字，必须与音频内容逐字一致
# CATGIRL_SOVITS_REF_TEXT=参考音频里说的那句话
# api_v2 用到的 ffmpeg 与 NLTK 数据目录，留空则用系统环境里已有的
# CATGIRL_SOVITS_FFMPEG=D:\ffmpeg
# CATGIRL_SOVITS_NLTK=D:\nltk_data

# ---------------- QQ（OneBot v11 协议端）----------------
# 开着才会接消息；qq.py 是独立进程，和 Web 服务可以同时跑
CATGIRL_QQ_ENABLED=false

# 协议端地址：本机 NapCat 用 127.0.0.1:3001；Docker Compose 里用 ws://napcat:3001
CATGIRL_QQ_WS=ws://127.0.0.1:3001

# 协议端的 access_token（NapCat WebUI 里配的那个）
CATGIRL_QQ_TOKEN=

# 连本机协议端不要走代理（容器内同理留空）
CATGIRL_QQ_PROXY=

# 允许的群号，逗号分隔。留空 = 不接任何群（安全默认）
CATGIRL_QQ_GROUPS=

# 主人的 QQ 号（可选）：设了之后，群里这个号说话会被猫娘认作主人，称呼更亲
CATGIRL_OWNER_QQ=

# 是否接私聊
CATGIRL_QQ_PRIVATE=true

# 群里是否必须 @ 才回
CATGIRL_QQ_AT_ONLY=true

# 群里把「昵称：」加在消息前面，方便她分清谁在说话
CATGIRL_QQ_NICKNAME=true

# 每条消息最短间隔（秒），防刷屏/防上游限流
CATGIRL_QQ_RATE=1.5

# 单条消息最大字数，超出自动分条
CATGIRL_QQ_MAX_CHARS=400

# 是否把回复同时发成语音（实验性：需要协议端能读到 /data 里的音频文件，且支持 mp3→silk）
CATGIRL_QQ_VOICE=false

# 图片识别：多模态模型名。留空 = 关闭（只发「［图片］」占位符）
# 本地版填 LM Studio 里加载的视觉模型名，例如 qwen2-vl-7b-instruct
CATGIRL_VISION_MODEL=
CATGIRL_VISION_BASE_URL=
CATGIRL_VISION_API_KEY=


