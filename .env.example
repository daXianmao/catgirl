# 复制成 .env 后按需填写。docker-compose 和 systemd 都会读这些。
# 云端部署版：模型全部走在线 API，不需要显卡，也不用装任何本地模型。

# ---------------- 对话模型 ----------------
# 服务商（都是在线 API，没有本地推理预设）：
#   openai / deepseek / moonshot / dashscope / zhipu / siliconflow / openrouter
CATGIRL_PROVIDER=dashscope

# 对话密钥（也可以用各家的标准变量名，例如 DASHSCOPE_API_KEY）
CATGIRL_API_KEY=

# 覆盖模型名（留空则用 provider 预设）
CATGIRL_MODEL=
CATGIRL_NAME=铃洛

# 向量模型可以单独指向另一家（deepseek/moonshot/openrouter 没有 embedding 接口）
# 例：对话用 deepseek，向量用硅基流动的 bge-m3
CATGIRL_EMBED_BASE_URL=
CATGIRL_EMBED_API_KEY=
CATGIRL_EMBED_MODEL=

# 对外接口密钥。设了之后所有 /api/* 都要带 Authorization: Bearer <这个值>
CATGIRL_SERVER_KEY=

# 数据目录（记忆库落在 <dataDir>/users/<用户标识>/memory.db）
CATGIRL_DATA=./data

# 服务监听
CATGIRL_HOST=0.0.0.0
CATGIRL_PORT=8000

# 记忆参数
CATGIRL_TOP_K=8
CATGIRL_RECENT_TURNS=12
CATGIRL_SUMMARY_EVERY=20
CATGIRL_MAX_MEMORIES=400

# ---------------- 语音 ----------------
# 后端：edge（默认，免费预设音色）/ siliconflow（云端克隆）/ openai / gptsovits（自建服务）/ none
CATGIRL_TTS_PROVIDER=edge

# 预设音色。edge 例：zh-CN-XiaoyiNeural；siliconflow 例：FunAudioLLM/CosyVoice2-0.5B:claire
CATGIRL_TTS_VOICE=

# 语音密钥（硅基流动 / OpenAI）。也可以用 SILICONFLOW_API_KEY、OPENAI_API_KEY
CATGIRL_TTS_KEY=

# 覆盖 TTS 服务地址（一般不用填，预设里已有）
CATGIRL_TTS_BASE_URL=

# edge 专用：语速、音调
CATGIRL_TTS_RATE=+0%
CATGIRL_TTS_PITCH=+0Hz

# 对话时自动合成语音（true 时 /api/chat 默认带 audioUrl）
CATGIRL_TTS_AUTO=false

# 服务器要走代理才出得去时填这里（edge 音色需要访问微软）
# CATGIRL_TTS_PROXY=http://127.0.0.1:7890

# ---------------- 可选：自建 GPT-SoVITS 服务 ----------------
# 只有 CATGIRL_TTS_PROVIDER=gptsovits 时才需要。
# 猫娘不会启动它，只当 HTTP 服务调用——所以它可以跑在任意一台带 GPU 的机器上。
# CATGIRL_SOVITS_URL=http://10.0.0.8:9880
# 参考音频填「服务端上的路径」，不是本机路径
# CATGIRL_SOVITS_REF=/opt/GPT-SoVITS/refs/bell.wav
# 参考音频里逐字对应的原话，必须一致
# CATGIRL_SOVITS_REF_TEXT=参考音频里说的那句话

# ---------------- QQ（OneBot v11 协议端）----------------
# 开着才会接消息；qq.py 是独立进程，和 Web 服务可以同时跑
CATGIRL_QQ_ENABLED=false

# 协议端地址：本机 NapCat 用 127.0.0.1:3001；Docker Compose 里用 ws://napcat:3001
# 协议端跑在宿主机（NapCat Shell + systemd，推荐）时，容器里用 host.docker.internal
CATGIRL_QQ_WS=ws://host.docker.internal:3001

# 协议端的 access_token（NapCat WebUI 里配的那个）
CATGIRL_QQ_TOKEN=

# 连本机协议端不要走代理（容器内同理留空）
CATGIRL_QQ_PROXY=

# 允许的群号，逗号分隔。留空 = 不接任何群（安全默认）
CATGIRL_QQ_GROUPS=

# 主人的 QQ 号（可选）：设了之后，群里这个号说话会被猫娘认作主人，称呼更亲
CATGIRL_OWNER_QQ=

# 是否接私聊
CATGIRL_QQ_PRIVATE=true

# 群里是否必须 @ 才回
CATGIRL_QQ_AT_ONLY=true

# 群里把「昵称：」加在消息前面，方便她分清谁在说话
CATGIRL_QQ_NICKNAME=true

# 每条消息最短间隔（秒），防刷屏/防上游限流
CATGIRL_QQ_RATE=1.5

# 单条消息最大字数，超出自动分条
CATGIRL_QQ_MAX_CHARS=400

# 是否把回复同时发成语音（edge 生成 mp3，NapCat 自动转 silk）
CATGIRL_QQ_VOICE=false

# 语音发送策略：
#   smart（默认）= 只在必要的时候发 —— 对方点名要语音（"发个语音""念出来"）、
#                  对方自己发语音（语音对语音）、特别开心（mood 是开心/得意，仅私聊）；
#                  对方说"别发语音"就静默 30 分钟
#   always        = 旧行为，每条回复后面都跟一条语音
CATGIRL_QQ_VOICE_MODE=smart

# 图片识别：多模态模型名。留空 = 关闭（只发「［图片］」占位符，不产生额外费用）
# baseUrl / apiKey 留空则复用主配置，一般只需要换 model 名
CATGIRL_VISION_MODEL=qwen3.7-plus
CATGIRL_VISION_BASE_URL=
CATGIRL_VISION_API_KEY=

# 语音识别：把 QQ 语音消息转成文字（走 dashscope qwen3-asr-flash，复用上面的对话 key）。
# 留空 = 关闭（只发「［语音］」占位符）。baseUrl / apiKey 留空则复用主配置。
CATGIRL_ASR_MODEL=qwen3-asr-flash
CATGIRL_ASR_BASE_URL=
CATGIRL_ASR_API_KEY=

# ---------------- QQ 官方机器人（推荐长期用）----------------
# 走 QQ 开放平台 OpenAPI v2，不是逆向协议，腾讯侧完全正常，不存在风控。
# 和上面的 NapCat 是二选一，别同时开（同一个群会被回两遍）。
# 启动：sudo docker compose --profile official up -d qqbot
CATGIRL_QQBOT_ENABLED=false

# q.qq.com → 创建机器人 → 开发设置里拿 AppID 和 AppSecret
CATGIRL_QQBOT_APP_ID=
CATGIRL_QQBOT_SECRET=

# 机器人没上线前只有沙箱环境可用（只能在自己是群主的沙箱群里测），先填 true
CATGIRL_QQBOT_SANDBOX=true

# 主人的 openid（不是 QQ 号！）。第一次私聊机器人后，日志里会打印
# 「发现一个 openid：xxxx」，把它抄到下面，之后就能被认成主人
CATGIRL_QQBOT_OWNER_OPENID=

# 两条消息之间的最短间隔（秒）和单条最大字数（平台限制同一消息最多回 5 条）
CATGIRL_QQBOT_RATE=1.2
CATGIRL_QQBOT_MAX_CHARS=400

# ---------------- 备选：手机桥接（真机方案，暂未启用）----------------
# 把一台安卓真机当网关：手机跑官方 QQ 客户端 + 通知监听脚本（deploy/phone_autojs.js），
# 主动连服务器上的 phone.py。零风控，但只能收发文字（图片/语音拿不到原文件）。
# 详细说明见 phone.py 文件头。
CATGIRL_PHONE_ENABLED=false
CATGIRL_PHONE_HOST=127.0.0.1
CATGIRL_PHONE_PORT=8765
# 必须设，否则谁连上来都能冒充手机
CATGIRL_PHONE_TOKEN=
CATGIRL_PHONE_PRIVATE=true
# 允许的群名，逗号分隔；留空 = 不接群；填 * = 接所有群
CATGIRL_PHONE_GROUPS=
